{
  "$schema": "../../schemas/ghostex-extension.schema.json",
  "name": "source-control",
  "title": "Source Control",
  "description": "Stage, commit, push, and review branch changes and history, with line notes for the active agent.",
  "version": "0.1.0",
  "author": "ferpart",
  "icon": "icon.svg",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "permissions": [
    "exec",
    "cli"
  ],
  "placements": [
    "popup",
    "view",
    "modal"
  ],
  "defaultPlacement": "popup",
  "server": {
    "static": "dist/"
  },
  "popup": {
    "width": 420,
    "height": 640
  },
  "modal": {
    "width": 1200,
    "height": 800
  }
}
