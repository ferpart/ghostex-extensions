{
  "$schema": "../../schemas/ghostex-extension.schema.json",
  "name": "explorer",
  "title": "Explorer",
  "description": "Browse and search project files, open them in Monaco, and send line notes to the active agent.",
  "version": "0.1.0",
  "author": "ferpart",
  "icon": "icon.svg",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "permissions": [
    "exec",
    "cli"
  ],
  "placements": [
    "popup",
    "view",
    "modal"
  ],
  "defaultPlacement": "popup",
  "server": {
    "static": "dist/"
  },
  "popup": {
    "width": 420,
    "height": 640
  },
  "modal": {
    "width": 1200,
    "height": 800
  }
}
