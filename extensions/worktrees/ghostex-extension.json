{
  "$schema": "../../schemas/ghostex-extension.schema.json",
  "name": "worktrees",
  "title": "Worktrees",
  "description": "See the pull request state of every git worktree and find the ones that are safe to delete.",
  "version": "0.1.0",
  "author": "ferpart",
  "icon": "icon.svg",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "permissions": [
    "exec",
    "cli"
  ],
  "placements": [
    "popup",
    "view",
    "modal"
  ],
  "defaultPlacement": "view",
  "server": {
    "static": "dist/"
  },
  "popup": {
    "width": 420,
    "height": 640
  },
  "modal": {
    "width": 1200,
    "height": 800
  }
}
